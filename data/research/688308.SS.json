    "name": "欧科亿",
    "fullName": "株洲欧科亿数控精密刀具股份有限公司",
    "industry": "通用设备",
    "regulatoryIndustry": "制造业-金属制品业",
    "exchange": "上海证券交易所",
    "chairman": "袁美和",
