    "name": "百利天恒",
    "fullName": "四川百利天恒药业股份有限公司",
    "industry": "生物制品",
    "regulatoryIndustry": "制造业-医药制造业",
    "exchange": "上海证券交易所",
    "chairman": "朱义",
