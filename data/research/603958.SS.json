    "name": "哈森股份",
    "fullName": "哈森商贸(中国)股份有限公司",
    "industry": "纺织服装",
    "regulatoryIndustry": "制造业-皮革、毛皮、羽毛及其制品和制鞋业",
    "exchange": "上海证券交易所",
    "chairman": "陈玉珍",
    "generalManager": "陈芳德",
